# Copy to terraform.tfvars and fill in the values.
# terraform.tfvars is gitignored — never commit it.

keycloak_username = "admin"
keycloak_password = ""

vault_root_token = "hvs.XXXXXXXXXXXXXXXXXXXXXXXX"

# Google — GCP Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# Authorized redirect URI: https://keycloak.nss.jkzl.eu/realms/ass-nss/broker/google/endpoint
google_client_id     = ""
google_client_secret = ""

# Group members — Gmail addresses. Users are pre-created in Keycloak and their Google identity
# is linked automatically on first login.
admin_members    = ["admin@example.com"]
curator_members  = []
analytic_members = []
user_members     = []
