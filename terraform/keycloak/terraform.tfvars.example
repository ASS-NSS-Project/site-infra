# Copy to terraform.tfvars and fill in the values.
# terraform.tfvars is gitignored — never commit it.

keycloak_username = "admin"
keycloak_password = ""

vault_root_token = "hvs.XXXXXXXXXXXXXXXXXXXXXXXX"

# Google — GCP Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# Authorized redirect URI: https://keycloak.nss.jkzl.eu/realms/ass-nss-project/broker/google/endpoint
google_client_id     = ""
google_client_secret = ""

# Group members — Gmail addresses. Users are pre-created in Keycloak and their Google identity
# is linked automatically on first login.
admin_members       = ["admin@example.com"]   # realm admin — full infra + Keycloak access
rag_admin_members   = []                       # RAG app admin + Keycloak RAG group management + Grafana
rag_curator_members = []                       # source/pipeline/incident management
rag_analyst_members = []                       # experiments and queries
rag_user_members    = []                       # query only
